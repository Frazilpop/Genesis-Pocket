`verilator_config
// What main.cpp reads inside system.sv: the YM2612's inputs, for --fm-log
public_flat_rd -module "system" -var "FM_CLKEN"
public_flat_rd -module "system" -var "Z80_RESET_N"
public_flat_rd -module "system" -var "ZBUS_A"
public_flat_rd -module "system" -var "ZBUS_WE"
public_flat_rd -module "system" -var "ZBUS_DO"
// the chips' own sound, for the save states' comparison (after.txt)
public_flat_rd -module "system" -var "FM_left"
public_flat_rd -module "system" -var "FM_right"
public_flat_rd -module "system" -var "PSG_SND"
// the save logic, to watch
public_flat_rd -module "system" -var "ss_st"
public_flat_rd -module "system" -var "fx_pc"
public_flat_rd -module "system" -var "fx_uaddr"
public_flat_rd -module "system" -var "st_pc"
public_flat_rd -module "system" -var "fx_atstart"
public_flat_rd -module "system" -var "fx_atdisp"
public_flat_rd -module "system" -var "fx_busidle"
public_flat_rd -module "system" -var "M68K_AS_N"
public_flat_rd -module "system" -var "mstate"
public_flat_rd -module "system" -var "ss_win"
public_flat_rd -module "system" -var "ss_ok68"
public_flat_rd -module "system" -var "ss_okZ"
public_flat_rd -module "system" -var "ss_okV"
public_flat_rd -module "system" -var "ss_okB"
public_flat_rd -module "system" -var "ss_tries"
public_flat_rd -module "system" -var "ss_park68"
public_flat_rd -module "system" -var "ss_hold68"
public_flat_rd -module "system" -var "z80_pc"
public_flat_rd -module "system" -var "Z80_RESET_N"
public_flat_rd -module "system" -var "Z80_BUSAK_N"
public_flat_rd -module "excUnit" -var "regs68L"
public_flat_rd -module "excUnit" -var "regs68H"
// the SVP, to watch (SIM_TRACE, SIM_BUSLOG, SIM_SSPLOG; tools/svp-trace.sh)
public_flat_rd -module "SVP_ghdl" -var "ssp_pa"
public_flat_rd -module "SVP_ghdl" -var "mas"
public_flat_rd -module "SVP_ghdl" -var "halt"
public_flat_rd -module "SVP_ghdl" -var "xst"
public_flat_rd -module "ssp160x_Brtl" -var "last_cycle"
public_flat_rd -module "ssp160x_Brtl" -var "ir"
public_flat_rd -module "ssp160x_Brtl" -var "pc"
public_flat_rd -module "ssp160x_Brtl" -var "a"
public_flat_rd -module "ssp160x_Brtl" -var "x"
public_flat_rd -module "ssp160x_Brtl" -var "y"
public_flat_rd -module "system" -var "M68K_A"
public_flat_rd -module "system" -var "M68K_DO"
public_flat_rd -module "system" -var "M68K_MBUS_D"
public_flat_rd -module "system" -var "M68K_UDS_N"
public_flat_rd -module "system" -var "M68K_LDS_N"
