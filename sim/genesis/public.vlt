// the serial save chip, for --i2c-log
public_flat_rd -module "system" -var "i2c_scl"
public_flat_rd -module "system" -var "i2c_sda"
public_flat_rd -module "system" -var "i2c_o"
public_flat_rd -module "system" -var "i2c_we"
